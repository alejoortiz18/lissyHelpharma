@using Models.Dto
@using Models.Entities.Domain
@using Models.Models
@model Empleado

@{
    ViewData["Title"] = "Home Page";
    var eventos = ViewBag.Eventos as List<TipoEventoEmpleado>;
    var solicitudes = ViewBag.Solicitudes as List<EstadoSolicitud>;
}

<!-- partial -->
<div class="main-panel">
    <div class="content-wrapper">

        <div class="row">
       
            <div class="col-12 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title" style="text-align:center;">Crear un evento a </h4>
                    <form class="form-sample">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-sm-3 col-form-label">Nombre</label>
                                    <div class="col-sm-9">
                                            <label type="text" class="form-control" />@Model.Nombres
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-sm-3 col-form-label">Apellido</label>
                                    <div class="col-sm-9">
                                            <label type="text" class="form-control" value="" />@Model.Apellidos
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-sm-3 col-form-label">Género</label>
                                    <div class="col-sm-9">
                                            <label type="text" class="form-control" value="" />@Model.Genero
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-sm-3 col-form-label">Fecha Nacimiento</label>
                                    <div class="col-sm-9">
                                            <label class="form-control" value="" />@Model.FechaNacimiento
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-sm-3 col-form-label">Idenficación</label>
                                    <div class="col-sm-9">
                                            <label type="text" class="form-control" value="" />@Model.NumeroIdentificacion
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-sm-3 col-form-label">Contrato con</label>
                                        <div class="col-sm-9">
                                            <label type="text" class="form-control" value="" />@Model.TipoContrato.Nombre
                                        </div>
                                  
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-sm-3 col-form-label">Fecha Ingreso Directo</label>
                                    <div class="col-sm-9">
                                            <label class="form-control" placeholder="dd/mm/yyyy" value="" />@Model.FechaIngresoDirecto
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-sm-3 col-form-label">Fecha Ingreso Temporal</label>
                                    <div class="col-sm-9">
                                            <label class="form-control" placeholder="dd/mm/yyyy" value="" />@Model.FechaIngresoTemporal
                                    </div>
                                </div>
                            </div>
                        </div>
                     
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-sm-3 col-form-label">Dirección</label>
                                    <div class="col-sm-9">
                                            <label type="text" class="form-control" value="" />@Model.Direccion
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-sm-3 col-form-label">Telefono</label>
                                    <div class="col-sm-9">
                                            <label type="text" class="form-control" value="" />@Model.Telefono
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-sm-3 col-form-label">Correo</label>
                                    <div class="col-sm-9">
                                            <label type="text" class="form-control" value="" />@Model.Correo
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-sm-3 col-form-label">Sede</label>
                                    <div class="col-sm-9">
                                            <label type="text" class="form-control" value="" />@Model.Sede.Nombre
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-sm-3 col-form-label">Cargo</label>
                                    <div class="col-sm-9">
                                            <label type="text" class="form-control" value="" />@Model.Cargo.Nombre
                                    </div>
                                </div>
                            </div>
                            
                        </div>
                    </form>
                </div>
            </div>
        </div>
            
       
            <div class="col-md-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title" style="text-align:center">CREAR EVENTO</h4>
                        <div class="form-group">
                            <label for="exampleFormControlSelect1">Tipo de evento</label>
                            <select class="form-control form-control-lg" id="exampleFormControlSelect1">
                                @foreach (var evento in eventos)
                                {
                                    @if (evento.Nombre.ToUpper() !="NINGUNO")
                                    {
                                        <option>@evento.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-sm-3 col-form-label">Fecha Inicio</label>
                                    <div class="col-sm-9">
                                        <input type="date" class="form-control fecha-custom" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-sm-3 col-form-label">Fecha Fin</label>
                                    <div class="col-sm-9">
                                        <input type="date" class="form-control fecha-custom" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group row">
                                    <label class="col-sm-3 col-form-label">Solicitudes</label>
                                    <div class="col-sm-9">
                                        <select class="form-control form-control-lg" id="exampleFormControlSelect1">
                                            @foreach (var solicitud in solicitudes)
                                            {
                                                if (solicitud.Nombre.ToUpper() != "NINGUNO")
                                                {
                                                    <option>@solicitud.Nombre</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group " >
                            <label for="exampleFormControlSelect1">Observación</label>
                                <input class="form-control" placeholder="Observación" />
                            
                        </div>

                        <div class="form-group">
                            <label>Subir soporte</label>
                            <input type="file" name="img[]" class="file-upload-default">
                            <div class="input-group col-xs-12">
                                <input type="text" class="form-control file-upload-info" disabled placeholder="Upload Image">
                                <span class="input-group-append">
                                    <button class="file-upload-browse btn btn-primary" type="button">Upload</button>
                                </span>
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="template-demo">
                                <button type="button" class="btn btn-outline-success btn-fw">Enviar</button>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </div>


           

        </div>


    </div>
</div>


