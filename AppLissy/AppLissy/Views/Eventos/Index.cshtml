@using Models.Dto
@using Models.Entities.Domain
@using Models.Models
@model Empleado

@{
    ViewData["Title"] = "Home Page";    
    var eventos = ViewBag.Eventos as List<TipoEventoEmpleado>;
    var solicitudes = ViewBag.Solicitudes as List<EstadoSolicitud> ?? new List<EstadoSolicitud>();    
}

<div class="main-panel">
    <div class="content-wrapper">

        <!-- ================= DATOS DEL EMPLEADO (SIN FORM) ================= -->
        <div class="row">
            <div class="col-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title text-center">Crear un evento a</h4>

                        <div class="row">
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Nombre</label>
                            <div class="col-sm-9">
                                    <label type="text" class="form-control" />@Model.Nombres
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Apellido</label>
                            <div class="col-sm-9">
                                    <label type="text" class="form-control" value="" />@Model.Apellidos
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Género</label>
                            <div class="col-sm-9">
                                    <label type="text" class="form-control" value="" />@Model.Genero
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Fecha Nacimiento</label>
                            <div class="col-sm-9">
                                    <label class="form-control" value="" />@Model.FechaNacimiento
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Idenficación</label>
                            <div class="col-sm-9">
                                    <label type="text" class="form-control" value="" />@Model.NumeroIdentificacion
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Contrato con</label>
                                <div class="col-sm-9">
                                    <label type="text" class="form-control" value="" />@Model.TipoContrato.Nombre
                                </div>
                  
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Fecha Ingreso Directo</label>
                            <div class="col-sm-9">
                                    <label class="form-control" placeholder="dd/mm/yyyy" value="" />@Model.FechaIngresoDirecto
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Fecha Ingreso Temporal</label>
                            <div class="col-sm-9">
                                    <label class="form-control" placeholder="dd/mm/yyyy" value="" />@Model.FechaIngresoTemporal
                            </div>
                        </div>
                    </div>
                </div>
     
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Dirección</label>
                            <div class="col-sm-9">
                                    <label type="text" class="form-control" value="" />@Model.Direccion
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Telefono</label>
                            <div class="col-sm-9">
                                    <label type="text" class="form-control" value="" />@Model.Telefono
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Correo</label>
                            <div class="col-sm-9">
                                    <label type="text" class="form-control" value="" />@Model.Correo
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Sede</label>
                            <div class="col-sm-9">
                                    <label type="text" class="form-control" value="" />@Model.Sede.Nombre
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Cargo</label>
                            <div class="col-sm-9">
                                    <label type="text" class="form-control" value="" />@Model.Cargo.Nombre
                            </div>
                        </div>
                    </div>
            
                </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- ================= FORMULARIO (ÚNICO FORM) ================= -->
        <div class="row">
            <div class="col-md-12 grid-margin stretch-card">

                <form asp-controller="Eventos" asp-action="Create" method="post" enctype="multipart/form-data" class="w-100">
                    @Html.AntiForgeryToken()

                    <div class="card">
                        <div class="card-body">
                            <h4 class="card-title text-center">CREAR EVENTO</h4>

                            <!-- Tipo Evento -->
                            <div class="form-group">
                                <label>Tipo de evento</label>
                                <select class="form-control form-control-lg" name="TipoEventoEmpleadoId">
                                    @foreach (var evento in eventos)
                                    {
                                        if (evento.Nombre.ToUpper() != "NINGUNO")
                                        {
                                            <option value="@evento.TipoEventoEmpleadoId">@evento.Nombre</option>
                                        }
                                    }
                                </select>
                            </div>

                            <!-- Fechas -->
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-3 col-form-label">Fecha Inicio</label>
                                        <div class="col-sm-9">
                                            <input type="date" class="form-control" name="FechaInicio" />
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-3 col-form-label">Fecha Fin</label>
                                        <div class="col-sm-9">
                                            <input type="date" class="form-control" name="FechaFin" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Solicitudes -->
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label class="col-sm-3 col-form-label">Solicitudes</label>
                                        <div class="col-sm-9">
                                            <select class="form-control form-control-lg" name="EstadoSolicitudId">
                                                @foreach (var solicitud in solicitudes)
                                                {
                                                    if (solicitud.Nombre.ToUpper() == "EN PROCESO")
                                                    {
                                                        <option value="@solicitud.EstadoSolicitudId">@solicitud.Nombre</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Observación -->
                            <div class="form-group">
                                <label>Observación</label>
                                <input class="form-control" name="Observacion" placeholder="Observación" />
                            </div>

                            <!-- Archivo -->
                            <div class="form-group">
                                <label>Subir soporte</label>
                                <input type="file" name="archivo" class="form-control" />
                            </div>

                            <!-- Botón -->
                            <div class="form-group text-center">
                                <button type="submit" class="btn btn-outline-success btn-fw">Enviar</button>
                            </div>

                        </div>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>