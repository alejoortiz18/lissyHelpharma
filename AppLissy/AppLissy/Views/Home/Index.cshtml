@using Models.Dto
@using Models.Entities.Domain
@using Models.Models
@model Paginacion<Empleado>

@{
    ViewData["Title"] = "Home Page";
}

<!-- partial -->
<div class="main-panel">
    <div class="content-wrapper">

        <div class="row">

            <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-center">

                        <h3 class="mb-1">
                            @(Model.Datos.Count(x => x.CargoId == 1))
                        </h3>

                        <h6 class="text-muted font-weight-normal">
                            Jefes
                        </h6>

                    </div>
                </div>
            </div>


            <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-center">

                        <h3 class="mb-1">
                            @Model.TotalRegistros
                        </h3>

                        <h6 class="text-muted font-weight-normal">
                            Total empleados
                        </h6>

                    </div>
                </div>
            </div>


            <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-center">

                        <h3 class="mb-1">
                            @(Model.Datos.Count(x =>
                                                        x.EventoEmpleadoEmpleados.Any(y =>
                                                        y.EstadoSolicitudId != 1 &&
                                                        y.EstadoSolicitudId != 7 &&
                                                        y.EstadoSolicitudId != 8)))
                        </h3>

                        <h6 class="text-muted font-weight-normal">
                            Personal con novedades
                        </h6>

                    </div>
                </div>
            </div>


            <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-center">

                        <h3 class="mb-1">
                            @(Model.Datos.Count(x =>
                                                        x.EventoEmpleadoEmpleados.Any(y =>
                                                        y.EstadoSolicitudId == 4 ||
                                                        y.EstadoSolicitudId == 7 ||
                                                        y.EstadoSolicitudId == 8)))
                        </h3>

                        <h6 class="text-muted font-weight-normal">
                            Personal con permisos
                        </h6>

                    </div>
                </div>
            </div>

        </div>

        <div class="row ">
            <div class="col-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                    </div>
                </div>
            </div>
        </div>
     
       
        <div class="row ">
            <div class="col-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Empleados</h4>
                        <div class="row mb-3">

                            <div class="col-md-4">
                                <input type="text" id="filtroNombre" class="form-control form-control-sm" placeholder="Buscar por nombre">
                            </div>

                            <div class="col-md-4">
                                <input type="text" id="filtroDocumento" class="form-control form-control-sm" placeholder="Buscar por documento">
                            </div>

                            <div class="col-md-4">
                                <input type="text" id="filtroCargo" class="form-control form-control-sm" placeholder="Buscar por cargo">
                            </div>

                        </div>

                        <div class="table-responsive">

                            <table class="table table-sm table-striped align-middle w-100" id="tablaEmpleados" style="table-layout:fixed;">

                                <thead class="table-dark">
                                    <tr>
                                        <th style="width:5%">ID</th>
                                        <th style="width:12%">Documento</th>
                                        <th style="width:15%">Nombre</th>
                                        <th style="width:15%">Apellido</th>
                                        <th style="width:18%">Correo</th>
                                        <th style="width:12%">Nacimiento</th>
                                        <th style="width:15%">Cargo</th>
                                        <th style="width:8%">Acción</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @if (Model != null && Model.Datos != null)
                                    {
                                        foreach (var item in Model.Datos)
                                        {
                                            <tr>
                                                <td>@item.EmpleadoId</td>

                                                <td class="text-nowrap">
                                                    @item.NumeroIdentificacion
                                                </td>

                                                <td>@item.Nombres</td>

                                                <td>@item.Apellidos</td>

                                                <td class="text-truncate">
                                                    @item.Correo
                                                </td>

                                                <td class="text-nowrap">
                                                    @item.FechaNacimiento.ToString("d MMM yyyy", new System.Globalization.CultureInfo("es-ES"))
                                                </td>

                                                <td class="text-truncate">
                                                    @item.Cargo.Nombre
                                                </td>

                                                <td>
                                                    <a asp-action="Detalle"
                                                       asp-route-id="@item.EmpleadoId"
                                                       class="btn btn-success btn-sm">
                                                        Ver
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }

                                </tbody>

                            </table>

                        </div>


                        <nav class="mt-3">
                            <ul class="pagination justify-content-center">

                                @for (int i = 1; i <= Model.TotalPaginas; i++)
                                {
                                    <li class="page-item @(i == Model.PaginaActual ? "active" : "")">

                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-pagina="@i">

                                            @i

                                        </a>

                                    </li>
                                }

                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
       
    </div>
    <!-- content-wrapper ends -->
  
</div>
<!-- main-panel ends -->


<script>

    document.querySelectorAll("#filtroNombre, #filtroDocumento, #filtroCargo")
    .forEach(input => {

        input.addEventListener("keyup", filtrarTabla);

    });

    function filtrarTabla(){

        let nombre = document.getElementById("filtroNombre").value.toLowerCase();
        let documento = document.getElementById("filtroDocumento").value.toLowerCase();
        let cargo = document.getElementById("filtroCargo").value.toLowerCase();

        let filas = document.querySelectorAll("#tablaEmpleados tbody tr");

        filas.forEach(fila => {

            let tdDocumento = fila.children[1].innerText.toLowerCase();
            let tdNombre = fila.children[2].innerText.toLowerCase();
            let tdApellido = fila.children[3].innerText.toLowerCase();
            let tdCargo = fila.children[7].innerText.toLowerCase();

            let coincideNombre = (tdNombre + " " + tdApellido).includes(nombre);
            let coincideDocumento = tdDocumento.includes(documento);
            let coincideCargo = tdCargo.includes(cargo);

            if(coincideNombre && coincideDocumento && coincideCargo){
                fila.style.display = "";
            }
            else{
                fila.style.display = "none";
            }

        });

    }

</script>